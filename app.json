{
  "expo": {
    "name": "ArlyTrack",
    "slug": "arlytrack",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "arlytrack",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.arlytrack.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a ArlyTrack registrar tus rutas incluso con la pantalla apagada o en el bolsillo.",
          "locationAlwaysPermission": "Permite a ArlyTrack registrar tus rutas en segundo plano mientras conduces.",
          "locationWhenInUsePermission": "Permite a ArlyTrack usar el GPS para registrar tu velocidad y ruta.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a ArlyTrack acceder a tus fotos para personalizar y compartir la tarjeta de tus rutas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2145f874-6e50-4eb7-8c03-db4d4f3fbca5"
      }
    }
  }
}
